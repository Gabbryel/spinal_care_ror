<%# Contact call-to-action for a public page.
    placement: "top" (under the hero) or "bottom" (after the price list).
    specialty: optional, names the consultation in the top title.
    title: optional override for the title.
    flush: true when the container already overlaps the hero (member page).
    key: optional, keeps the title id unique when a page has several cards.
    The button opens the booking modal (tracked as a booking click) and the
    phone link is a tel: link (tracked as a call). %>
<% top = placement == "top" %>
<% title_id = ["specialty-cta", placement, local_assigns[:key], "title"].compact.join("-") %>
<% specialty = local_assigns[:specialty] %>
<% title = local_assigns[:title] || (top && specialty ? "Programează o consultație de #{specialty.name.downcase}" : (top ? "Programează o consultație" : "Programează-te acum")) %>
<aside class="specialty-cta specialty-cta--<%= placement %><%= ' specialty-cta--flush' if local_assigns[:flush] %>" aria-labelledby="<%= title_id %>">
  <div class="specialty-cta-text">
    <p class="specialty-cta-title" id="<%= title_id %>">
      <%= title %>
    </p>
    <p class="specialty-cta-subtitle">
      Online în câteva minute sau sună-ne pentru detalii și disponibilitate.
    </p>
  </div>
  <%= render "specialties/contact_cta_actions" %>
</aside>
