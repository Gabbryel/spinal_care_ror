<%= form_with model: survey, url: (survey.persisted? ? dashboard_survey_path(survey) : dashboard_surveys_path), class: "sv-form" do |f| %>
  <% if survey.errors.any? %>
    <div class="sv-error" role="alert"><%= survey.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="sv-field">
    <%= f.label :title, "Titlu" %>
    <%= f.text_field :title, required: true %>
  </div>
  <div class="sv-field">
    <%= f.label :intro, "Text introductiv (apare deasupra formularului)" %>
    <%= f.text_area :intro, rows: 3 %>
  </div>
  <div class="sv-field">
    <%= f.label :thank_you, "Mesaj de mulțumire (după trimitere)" %>
    <%= f.text_area :thank_you, rows: 2 %>
  </div>
  <% if survey.persisted? %>
    <div class="sv-field">
      <%= f.label :alert_emails, "Emailuri pentru alerte (răspunsuri negative)" %>
      <%= f.text_field :alert_emails, placeholder: "ex. manager@spinalcare.ro, calitate@spinalcare.ro" %>
      <small>
        Separate prin virgulă.
        <% if ENV["POSTMARK_API_TOKEN"].blank? %>
          <strong>Trimiterea de emailuri nu este încă configurată pe server</strong>; alertele apar deocamdată doar în dashboard.
        <% end %>
      </small>
    </div>
    <label class="sv-check">
      <%= f.check_box :active %>
      Activ pe site (pacienții îl pot completa)
    </label>
  <% end %>
  <%= f.submit survey.persisted? ? "Salvează" : "Creează chestionarul", class: "sv-btn sv-btn--primary" %>
<% end %>
