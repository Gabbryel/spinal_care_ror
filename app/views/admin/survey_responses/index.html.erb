<div class="sv-page">
  <header class="sv-header">
    <div>
      <p class="sv-crumb"><%= link_to "Chestionare", dashboard_surveys_path %></p>
      <h1><%= @survey.title %></h1>
    </div>
    <%= link_to "Descarcă CSV", dashboard_survey_responses_path(@survey, @filter.to_h.except("page").merge(format: :csv)), class: "sv-btn" %>
  </header>
  <%= render "admin/surveys/nav", survey: @survey %>

  <%= form_with url: dashboard_survey_responses_path(@survey), method: :get, class: "sv-filters" do %>
    <div class="sv-field">
      <label for="f-period">Perioada</label>
      <%= select_tag :period, options_for_select([["Tot", ""], ["30 de zile", "30"], ["90 de zile", "90"], ["Un an", "365"]], @filter[:period]), id: "f-period" %>
    </div>
    <div class="sv-field">
      <label for="f-only">Răspunsuri</label>
      <%= select_tag :only, options_for_select([["Toate", ""], ["Doar negative", "alerts"]], @filter[:only]), id: "f-only" %>
    </div>
    <div class="sv-field">
      <label for="f-status">Stare</label>
      <%= select_tag :status, options_for_select([["Toate", ""]] + SurveyResponse::STATUSES.invert.to_a, @filter[:status]), id: "f-status" %>
    </div>
    <% segment_options = @survey.questions.select(&:segment).flat_map { |q| q.labels.map { |l| ["#{q.short_text}: #{l}", "#{q.id}:#{l}"] } } %>
    <% if segment_options.any? %>
      <div class="sv-field">
        <label for="f-segment">Grup</label>
        <%= select_tag :segment, options_for_select([["Toate", ""]] + segment_options, @filter[:segment]), id: "f-segment" %>
      </div>
    <% end %>
    <div class="sv-field">
      <label for="f-weak">Răspuns slab la</label>
      <%= select_tag :weak_on, options_for_select([["Orice întrebare", ""]] + @survey.questions.select(&:rating?).map { |q| [q.short_text.truncate(60), q.id] }, @filter[:weak_on]), id: "f-weak" %>
    </div>
    <button type="submit" class="sv-btn sv-btn--primary">Filtrează</button>
    <% if @filter.to_h.except("page").values.any?(&:present?) %>
      <%= link_to "Toate răspunsurile", dashboard_survey_responses_path(@survey), class: "sv-btn" %>
    <% end %>
  <% end %>

  <p class="sv-note">
    <strong><%= number_with_delimiter(@total) %></strong> <%= @total == 1 ? "răspuns" : "răspunsuri" %>
    <% if @weak_question %> care au evaluat slab „<%= @weak_question.short_text %>”<% end %>, cele mai noi primele.
  </p>

  <% if @responses.empty? %>
    <section class="sv-panel"><p class="sv-empty">Niciun răspuns pentru filtrele alese.</p></section>
  <% else %>
    <div class="sv-rcards sv-rcards--list">
      <% @responses.each do |r| %>
        <%= render "card", response: r %>
      <% end %>
    </div>
    <% pages = (@total.to_f / Admin::SurveyResponsesController::PER_PAGE).ceil %>
    <% if pages > 1 %>
      <nav class="sv-pager" aria-label="Pagini">
        <% if @page > 1 %><%= link_to "← Anterioare", dashboard_survey_responses_path(@survey, @filter.to_h.merge("page" => @page - 1)) %><% end %>
        <span>Pagina <%= @page %> din <%= pages %></span>
        <% if @page < pages %><%= link_to "Următoare →", dashboard_survey_responses_path(@survey, @filter.to_h.merge("page" => @page + 1)) %><% end %>
      </nav>
    <% end %>
  <% end %>
</div>
