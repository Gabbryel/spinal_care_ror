<% if access %>
  <div class="audit-report-page">
    <div class="audit-report-header">
      <div>
        <h1 class="audit-report-title">Jurnal de activitate</h1>
        <p class="audit-report-subtitle">Ce a făcut fiecare utilizator în dashboard, pe zile.</p>
      </div>
      <%= link_to dashboard_path, class: 'btn-back-new' do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Înapoi
      <% end %>
    </div>

    <nav class="audit-period" aria-label="Perioadă">
      <% AdminController::PERIODS.each do |value, label| %>
        <%= link_to label, dashboard_audit_path(period: value, user: @selected_user&.id),
                    class: "audit-period-pill #{'active' if @period == value}",
                    aria: { current: (@period == value ? 'true' : nil) } %>
      <% end %>
    </nav>

    <% if @user_cards.empty? %>
      <div class="empty-state"><p>Nicio activitate înregistrată în perioada selectată.</p></div>
    <% else %>
      <div class="audit-users" role="list" aria-label="Utilizatori">
        <% @user_cards.each do |card| %>
          <% u = card[:user] %>
          <%= link_to dashboard_audit_path(period: @period, user: u.id),
                      class: "audit-user-card #{'active' if @selected_user == u}", role: 'listitem',
                      aria: { current: (@selected_user == u ? 'true' : nil) } do %>
            <span class="audit-user-avatar" aria-hidden="true"><%= u.email.first(1).upcase %></span>
            <span class="audit-user-body">
              <span class="audit-user-name"><%= u.alias.presence || u.email %></span>
              <span class="audit-user-email"><%= u.email if u.alias.present? %></span>
              <span class="audit-user-role"><%= u.god_mode ? 'God mode' : (u.admin ? 'Admin' : 'Utilizator') %></span>
              <span class="audit-user-stats">
                <strong><%= card[:changes] %></strong> modificări ·
                <strong><%= card[:logins] %></strong> autentificări ·
                <strong><%= card[:views] %></strong> pagini
              </span>
              <span class="audit-user-last">Ultima activitate: <%= l(card[:last_at], format: '%d.%m.%Y %H:%M') %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @report %>
      <% s = @report.summary %>
      <section class="audit-user-report" aria-labelledby="audit-report-heading" data-controller="journal-search">
        <h2 id="audit-report-heading" class="audit-report-user">
          <%= @selected_user.alias.presence || @selected_user.email %>
          <span class="audit-report-period"><%= AdminController::PERIODS[@period].downcase == 'tot' ? 'toată perioada' : "ultimele #{AdminController::PERIODS[@period]}" %></span>
        </h2>

        <div class="audit-summary">
          <div class="audit-summary-tile">
            <div class="audit-summary-value"><%= s[:changes] %></div>
            <div class="audit-summary-label">modificări</div>
            <div class="audit-summary-sub"><%= s[:creates] %> creări · <%= s[:updates] %> editări · <%= s[:destroys] %> ștergeri</div>
          </div>
          <div class="audit-summary-tile">
            <div class="audit-summary-value"><%= s[:logins] %></div>
            <div class="audit-summary-label">autentificări</div>
          </div>
          <div class="audit-summary-tile">
            <div class="audit-summary-value"><%= s[:days_active] %></div>
            <div class="audit-summary-label">zile active</div>
          </div>
          <div class="audit-summary-tile">
            <div class="audit-summary-value"><%= s[:views] %></div>
            <div class="audit-summary-label">pagini vizualizate</div>
          </div>
          <div class="audit-summary-tile <%= 'audit-summary-tile--bad' if s[:errors] > 0 %>">
            <div class="audit-summary-value"><%= s[:errors] %></div>
            <div class="audit-summary-label">erori</div>
          </div>
        </div>

        <% if s[:by_type].any? %>
          <p class="audit-by-type">
            <span class="audit-by-type-label">A modificat:</span>
            <% s[:by_type].each do |label, n| %>
              <span class="audit-chip"><%= label %> <strong><%= n %></strong></span>
            <% end %>
          </p>
        <% end %>

        <% if @report.days.empty? %>
          <div class="empty-state"><p>Nicio activitate în perioada selectată.</p></div>
        <% else %>
          <div class="journal-search" role="search">
            <label for="journal-search-input" class="journal-search-label">Caută în activitate</label>
            <div class="journal-search-field">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false" class="journal-search-icon">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
              </svg>
              <input type="search" id="journal-search-input" class="journal-search-input" placeholder="ex. Terapie manuală, șters, preț, /servicii-medicale"
                     autocomplete="off" spellcheck="false"
                     data-journal-search-target="input" data-action="input->journal-search#filter keydown->journal-search#keydown">
              <button type="button" class="journal-search-clear" data-journal-search-target="clear" data-action="journal-search#clear" hidden aria-label="Șterge căutarea">×</button>
            </div>
            <span class="journal-search-count" data-journal-search-target="count" aria-live="polite"></span>
          </div>
          <div class="empty-state" data-journal-search-target="empty" hidden><p>Niciun rezultat pentru această căutare.</p></div>
        <% end %>

        <% @report.days.each do |day| %>
          <article class="audit-day" data-journal-search-target="day">
            <h3 class="audit-day-title">
              <%= day.label %>
              <span class="audit-day-count"><%= day.entries.size %> <%= day.entries.size == 1 ? 'acțiune' : 'acțiuni' %><%= ", #{day.views.size} pagini" if day.views.any? %></span>
            </h3>
            <% if day.entries.any? %>
              <ol class="audit-entries">
                <% day.entries.each do |e| %>
                  <li class="audit-entry audit-entry--<%= e.kind %>" data-journal-search-target="entry">
                    <time class="audit-entry-time" datetime="<%= e.time.iso8601 %>"><%= e.time.strftime('%H:%M') %></time>
                    <span class="audit-entry-icon" aria-hidden="true"><%= { 'create' => '+', 'update' => '✎', 'destroy' => '−', 'login' => '→', 'logout' => '←' }[e.kind] || '•' %></span>
                    <div class="audit-entry-body">
                      <div class="audit-entry-text"><%= e.text %></div>
                      <% if e.details.any? %>
                        <ul class="audit-entry-details">
                          <% e.details.each do |d| %><li><%= d %></li><% end %>
                        </ul>
                      <% end %>
                      <% if e.meta.present? %><div class="audit-entry-meta"><%= e.meta %></div><% end %>
                    </div>
                  </li>
                <% end %>
              </ol>
            <% end %>
            <% if day.views.any? %>
              <details class="audit-views" data-journal-search-target="views">
                <summary>a vizualizat <%= day.views.size %> <%= day.views.size == 1 ? 'pagină' : 'pagini' %></summary>
                <ul class="audit-views-list">
                  <% day.views.each do |v| %>
                    <li data-journal-search-target="view">
                      <time datetime="<%= v.time.iso8601 %>"><%= v.time.strftime('%H:%M') %></time>
                      <code><%= v.path %></code>
                      <% if v.duration_ms %><span class="audit-views-meta"><%= v.duration_ms %> ms</span><% end %>
                      <% if v.status_code.to_i >= 400 %><span class="audit-views-error">eroare <%= v.status_code %></span><% end %>
                    </li>
                  <% end %>
                </ul>
              </details>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>
  </div>
<% else %>
  <%= render 'shared/no_access' %>
<% end %>
